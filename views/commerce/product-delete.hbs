<div class="text-center" style="max-width: 500px; margin: 2rem auto;">
  <h4 class="mb-4">¿Está seguro que desea eliminar este producto?</h4>
  <img src="{{product.image}}" alt="producto" width="96" height="96" class="rounded object-fit-cover mb-2">
  <p class="text-muted">Producto: <strong>{{product.name}}</strong></p>
  <div class="d-flex justify-content-center gap-3 mt-4">
    <a href="/commerce/products" class="btn btn-secondary">Cancelar</a>
    <form action="/commerce/products/{{product._id}}/delete" method="POST">
      <button type="submit" class="btn btn-danger">Aceptar</button>
    </form>
  </div>
</div>