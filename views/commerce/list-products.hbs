<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Productos</h2>
  <a href="/commerce/products/create" class="btn btn-primary">Crear producto</a>
</div>
<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr><th>Imagen</th><th>Nombre</th><th>Descripción</th><th>Categoría</th><th>Precio</th><th></th></tr>
    </thead>
    <tbody>
      {{#each products}}
      <tr>
        <td><img src="{{this.image}}" alt="producto" width="56" height="56" class="rounded object-fit-cover"></td>
        <td>{{this.name}}</td>
        <td>{{this.description}}</td>
        <td>{{this.category.name}}</td>
        <td>RD$ {{this.price}}</td>
        <td>
          <a href="/commerce/products/{{this._id}}/edit" class="btn btn-sm btn-warning">Editar</a>
          <a href="/commerce/products/{{this._id}}/delete" class="btn btn-sm btn-danger">Eliminar</a>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="6" class="text-center text-muted">No hay productos</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>