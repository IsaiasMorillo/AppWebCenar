<h2 class="mb-3">{{#if isEdit}}Editar producto{{else}}Crear producto{{/if}}</h2>

{{#if categories.length}}
<form action="{{#if isEdit}}/commerce/products/{{product._id}}/edit{{else}}/commerce/products/create{{/if}}"
      method="POST" enctype="multipart/form-data" style="max-width: 600px;">
  <div class="mb-3">
    <label class="form-label">Nombre</label>
    <input type="text" name="name" value="{{product.name}}" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Descripción</label>
    <input type="text" name="description" value="{{product.description}}" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Precio</label>
    <input type="number" name="price" value="{{product.price}}" class="form-control" min="0" step="0.01" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Categoría</label>
    <select name="category" class="form-select" required>
      <option value="">Seleccione...</option>
      {{#each categories}}
        <option value="{{this._id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Foto del producto</label>
    {{#if isEdit}}
      <div class="mb-2"><img src="{{product.image}}" alt="imagen actual" width="80" height="80" class="rounded object-fit-cover"></div>
      <input type="file" name="image" class="form-control" accept="image/*">
      <div class="form-text">Déjalo vacío para conservar la imagen actual.</div>
    {{else}}
      <input type="file" name="image" class="form-control" accept="image/*" required>
    {{/if}}
  </div>
  <div class="d-flex justify-content-between">
    <a href="/commerce/products" class="btn btn-secondary">Volver</a>
    <button type="submit" class="btn btn-primary">{{#if isEdit}}Guardar{{else}}Crear{{/if}}</button>
  </div>
</form>
{{else}}
<div class="alert alert-warning">
  Primero debes crear al menos una categoría.
  <a href="/commerce/categories/create" class="alert-link">Crear categoría</a>
</div>
<a href="/commerce/products" class="btn btn-secondary">Volver</a>
{{/if}}