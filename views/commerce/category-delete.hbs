<div class="text-center" style="max-width: 500px; margin: 2rem auto;">
  <h4 class="mb-4">¿Está seguro que desea eliminar esta categoría?</h4>
  <p class="text-muted">Categoría: <strong>{{category.name}}</strong></p>
  <div class="d-flex justify-content-center gap-3 mt-4">
    <a href="/commerce/categories" class="btn btn-secondary">Cancelar</a>
    <form action="/commerce/categories/{{category._id}}/delete" method="POST">
      <button type="submit" class="btn btn-danger">Aceptar</button>
    </form>
  </div>
</div>