<h2 class="mb-3">Editar configuración</h2>
<form action="/admin/config/edit" method="POST" style="max-width: 400px;">
  <div class="mb-3">
    <label class="form-label">ITBIS (%)</label>
    <input type="number" name="itbis" value="{{config.itbis}}" class="form-control" min="0" max="100" step="0.01" required>
  </div>
  <div class="d-flex justify-content-between">
    <a href="/admin/config" class="btn btn-secondary">Volver</a>
    <button type="submit" class="btn btn-primary">Guardar</button>
  </div>
</form>