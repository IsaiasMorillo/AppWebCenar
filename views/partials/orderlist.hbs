{{#each orders}}
<a href="{{../base}}/{{this._id}}" class="text-decoration-none text-reset">
  <div class="card mb-2">
    <div class="card-body d-flex align-items-center gap-3">
      <img src="{{this.commerce.logo}}" alt="logo" width="56" height="56" class="rounded object-fit-cover">
      <div>
        <span class="badge bg-{{this.statusClass}}">{{this.statusLabel}}</span>
        <small class="text-muted ms-1">{{this.dateLabel}}</small>
        <div class="fw-semibold">{{this.commerce.commerceName}}</div>
        <small class="text-muted">RD$ {{this.totalLabel}} · {{this.itemsCount}} producto(s)</small>
      </div>
    </div>
  </div>
</a>
{{else}}
<p class="text-muted">No hay pedidos.</p>
{{/each}}