<h2 class="mb-1">Favoritos</h2>
<p class="text-muted">Pide a donde más te gusta</p>

{{#each commerces}}
<div class="card mb-2">
  <div class="card-body d-flex align-items-center gap-3">
    <a href="/client/commerces/{{this._id}}" class="d-flex align-items-center gap-3 text-decoration-none text-reset flex-grow-1">
      <img src="{{this.logo}}" alt="logo" width="56" height="56" class="rounded object-fit-cover">
      <span class="fw-semibold">{{this.commerceName}}</span>
    </a>
    <form action="/client/favorites/{{this._id}}/remove" method="POST">
      <button type="submit" class="btn btn-danger btn-sm">Remover</button>
    </form>
  </div>
</div>
{{else}}
<p class="text-muted">Aún no tienes comercios favoritos.</p>
{{/each}}