<div class="text-center" style="max-width: 500px; margin: 2rem auto;">
  <h4 class="mb-4">¿Está seguro que desea eliminar esta dirección?</h4>
  <p class="text-muted">Dirección: <strong>{{address.name}}</strong> · {{address.description}}</p>
  <div class="d-flex justify-content-center gap-3 mt-4">
    <a href="/client/addresses" class="btn btn-secondary">Cancelar</a>
    <form action="/client/addresses/{{address._id}}/delete" method="POST">
      <button type="submit" class="btn btn-danger">Aceptar</button>
    </form>
  </div>
</div>