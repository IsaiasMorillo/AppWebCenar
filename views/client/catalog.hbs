<div class="d-flex align-items-center gap-3 mb-3">
  <a href="/client/types/{{commerce.commerceType}}" class="btn btn-secondary btn-sm">Volver</a>
  <img src="{{commerce.logo}}" alt="logo" width="48" height="48" class="rounded object-fit-cover">
  <h2 class="mb-0">{{commerce.commerceName}}</h2>
</div>

<div class="row">
  <div class="col-lg-8">
    {{#each categories}}
    <h4 class="mt-3">{{this.name}}</h4>
    <div class="row g-2">
      {{#each this.products}}
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body d-flex gap-3">
            <div class="flex-grow-1 d-flex flex-column">
              <div class="fw-semibold">{{this.name}}</div>
              <small class="text-muted flex-grow-1">{{this.description}}</small>
              <div class="d-flex align-items-center gap-2 mt-2">
                <strong>RD$ {{this.priceLabel}}</strong>
                {{#unless this.inCart}}
                <form action="/client/cart/add/{{this._id}}" method="POST">
                  <button type="submit" class="btn btn-danger btn-sm">Agregar</button>
                </form>
                {{/unless}}
              </div>
            </div>
            <img src="{{this.image}}" alt="producto" width="96" height="96" class="rounded object-fit-cover">
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="text-muted">Este comercio aún no tiene productos.</p>
    {{/each}}
  </div>

  <div class="col-lg-4 mt-4 mt-lg-0">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Mi pedido</h5>
        {{#if cart}}
          {{#each cart.items}}
          <div class="d-flex align-items-center justify-content-between gap-2 border rounded p-2 mb-2">
            <small class="flex-grow-1">{{this.name}}</small>
            <form action="/client/cart/remove/{{this.productId}}" method="POST">
              <button type="submit" class="btn btn-danger btn-sm py-0">Eliminar</button>
            </form>
            <small>RD$ {{this.priceLabel}}</small>
          </div>
          {{/each}}
          <div class="d-flex justify-content-between mt-3">
            <span>Subtotal</span><strong>RD$ {{cart.subtotalLabel}}</strong>
          </div>
          <a href="/client/checkout" class="btn btn-danger w-100 mt-3">Continuar</a>
        {{else}}
          <p class="text-muted text-center my-4">Tu pedido está vacío</p>
        {{/if}}
      </div>
    </div>
  </div>
</div>