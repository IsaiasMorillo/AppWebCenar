<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Mis direcciones</h2>
  <a href="/client/addresses/create" class="btn btn-danger">+ Dirección</a>
</div>

{{#each addresses}}
<div class="card mb-2">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <div class="fw-semibold">{{this.name}}</div>
      <small class="text-muted">{{this.description}}</small>
    </div>
    <div>
      <a href="/client/addresses/{{this._id}}/edit" class="btn btn-sm btn-warning">Editar</a>
      <a href="/client/addresses/{{this._id}}/delete" class="btn btn-sm btn-danger">Eliminar</a>
    </div>
  </div>
</div>
{{else}}
<p class="text-muted">Aún no tienes direcciones.</p>
{{/each}}