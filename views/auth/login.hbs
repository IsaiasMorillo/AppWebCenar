<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-3 text-center">AppCenar</h2>
    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label">Correo o nombre de usuario</label>
        <input type="text" name="identifier" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
    </form>

    <hr>
    <div class="d-grid gap-2">
      <a href="/register" class="btn btn-outline-secondary">Registrarme como cliente o delivery</a>
      <a href="/register-commerce" class="btn btn-outline-secondary">Registrar mi comercio</a>
      <a href="/forgot-password" class="btn btn-link">Restablecer contraseña</a>
    </div>
  </div>
</div>